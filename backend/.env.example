# Backend Environment Example

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/yourdb
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_random_jwt_secret_64_hex_chars
JWT_EXPIRES_IN=7d

# Email - Brevo API
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=YourAppName

# AI Chat — Anthropic Claude (Primary)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Fallback AI (OpenAI / Groq)
AI_API_KEY=gsk_...
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_CONTACT=mailto:you@example.com

# -------------------------------------------------
# Setup Instructions
# -------------------------------------------------
# 1. JWT Secret
#    Generate a secure secret for JWT signing:
#    - Node:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#    - Python: python -c "import secrets; print(secrets.token_hex(64))"
#
# 2. Brevo (Sendinblue) API Key
#    - Sign up / log in at https://www.brevo.com
#    - Go to Settings → API keys → Create a new API key (starts with xkeysib-)
#    - Verify sender email:
#        * Settings → Sender & Domain → Add sender email
#        * Follow verification email link
#    - Set EMAIL_FROM to the verified email and EMAIL_FROM_NAME as you like.
#
# 3. AI Provider API Key & URL
#    - Obtain an API key from your chosen provider (Groq, OpenAI, Together, etc.).
#    - Set AI_API_KEY to the key and AI_API_URL to the provider endpoint.
#
# 4. VAPID keys for Web Push
#    - Install the web-push library (if not already):
#        npm install -g web-push   # global install
#        # or as a dev dependency:
#        npm i --save-dev web-push
#    - Generate keys:
#        npx web-push generate-vapid-keys
#      This prints a PUBLIC and PRIVATE key.
#    - Copy the output to VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY.
#
# Save this file as .env in the backend root after filling in the values.

